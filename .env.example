# Required: Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM model name
GROQ_MODEL=openai/gpt-oss-120b

# Optional: override if Tesseract is installed in a non-standard location
# On Linux / Docker, this is auto-detected via PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: custom directory for local Chroma database
# CHROMA_DIR=./chroma_db
